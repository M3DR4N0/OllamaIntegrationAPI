{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LLM_MAX_NUM_CTX": "8192",
  "LLM_RESPONSE_BUFFER": "512",
  "Ai": {
    "DefaultProvider": "Gemini",
    "DefaultLanguage": "es",
    "ForceSpanishResponses": true,
    "Temperature": 0.2,
    "MaxTokens": 4096,

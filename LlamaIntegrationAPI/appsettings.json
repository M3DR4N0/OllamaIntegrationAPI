      },
      "Claude": {
        "ApiKey": "",
        "BaseUrl": "https://api.anthropic.com",
        "Model": "claude-sonnet-4-5",
        "MaxTokens": 8192
      },
      "Groq": {
        "ApiKey": "",
        "BaseUrl": "https://api.groq.com/openai/v1",
        "Model": "llama-3.3-70b-versatile",
        "MaxTokens": 8192
      }
    }
  },
  "AllowedHosts": "*"
}
